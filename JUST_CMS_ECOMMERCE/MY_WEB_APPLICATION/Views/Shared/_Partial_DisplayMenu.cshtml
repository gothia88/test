		Html.DtxActionLink(Resources.Models.User.UpdateUserBankInformation,
			MVC.Account.UpdateUserBankInformation(),
			Infrastructure.Enums.ActionLinksTypes.SimpleLink);

	if (oItemValue != null)
	{
		string strMenuItem = string.Empty;

		strMenuItem +=
			string.Format("<li>{0}</li>",
			oItemValue.ToHtmlString());

		varItems.Add(strMenuItem);
	}
	// **************************************************

	// **************************************************
	oItemValue =
		Html.DtxActionLink(Resources.Models.ECommerce.Transaction.DisplayMyTransaction,
			MVC.ECommerce.Transaction.DisplayDataForUser(),
			Infrastructure.Enums.ActionLinksTypes.SimpleLink);

	if (oItemValue != null)
	{
		string strMenuItem = string.Empty;

		strMenuItem +=
			"<li class='divider'></li>";

		strMenuItem +=
			string.Format("<li>{0}</li>",
			oItemValue.ToHtmlString());

		varItems.Add(strMenuItem);
	}
	// **************************************************

	// **************************************************
	if (Infrastructure.ECommerce.Settings.Instance.IsCreditTransferEnabled)
	{
		oItemValue =
			Html.DtxActionLink(Resources.Models.ECommerce.Transaction.TransferCreditToAnotherUser,
				MVC.ECommerce.Transaction.TransferCreditToAnotherUser(),
				Infrastructure.Enums.ActionLinksTypes.SimpleLink);

		if (oItemValue != null)
		{
			string strMenuItem = string.Empty;

			strMenuItem +=
				string.Format("<li>{0}</li>",
				oItemValue.ToHtmlString());

			varItems.Add(strMenuItem);
		}
	}
	// **************************************************

	// **************************************************
	oItemValue =
		Html.DtxActionLink(Resources.Models.ECommerce.Transaction.IncreaseCreditByOnlinePayment,
			MVC.ECommerce.Transaction.IncreaseCreditByOnlinePayment(),
			Infrastructure.Enums.ActionLinksTypes.SimpleLink);

	if (oItemValue != null)
	{
		string strMenuItem = string.Empty;

		strMenuItem +=
			string.Format("<li>{0}</li>",
			oItemValue.ToHtmlString());

		varItems.Add(strMenuItem);
	}
	// **************************************************

	if (varItems.Count > 0)
	{
		<ul class="nav navbar-nav">
			<li class="dropdown">
				<a href="#" class="dropdown-toggle" data-toggle="dropdown">@Resources.MenuItems.ECommerceSystem<b class="caret"></b></a>
				<ul class="dropdown-menu" role="menu">
					@foreach (var varItem in varItems)
					{
						@Html.Raw(varItem)
					}
				</ul>
			</li>
		</ul>
	}
}

@helper DisplayMenu()
{
	<div class="container">
		<nav class="navbar navbar-default" role="navigation" style="z-index: 900">
			<div class="container-fluid">
				<div class="navbar-header">
					<button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbarSub" aria-expanded="false" aria-controls="navbar">
						<span class="sr-only">Toggle navigation</span>
						<span class="icon-bar"></span>
						<span class="icon-bar"></span>
						<span class="icon-bar"></span>
					</button>
				</div>

				<div id="navbarSub" class="navbar-collapse collapse">
					@DisplayUserControlPanelMenu()

					@if (Infrastructure.ApplicationSettings.Instance.IsECommerceSystemEnabled)
					{
						if (Infrastructure.Sessions.AuthenticatedUser.IsSiteResponsible == false)
						{
							@DisplayECommerceControlPanelForUserMenu()
						}
					}

					@DisplayAdministratorControlPanelMenu()

					@if (Infrastructure.ApplicationSettings.Instance.IsCmsEnabled)
					{
						@DisplayCmsControlPanelMenu()
					}

					@if (Infrastructure.ApplicationSettings.Instance.IsECommerceSystemEnabled)
					{
						@DisplayECommerceControlPanelMenu()
					}

					@DisplayProgrammerControlPanelMenu()
				</div>
			</div>
		</nav>
	</div>
}

@if (Infrastructure.AuthenticatedUser.IsAuthenticated)
{
	@DisplayMenu()
}
