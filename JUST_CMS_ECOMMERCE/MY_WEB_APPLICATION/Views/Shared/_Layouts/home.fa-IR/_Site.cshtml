<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />

	<link href="~/favicon.ico" rel="shortcut icon" />

	@Html.Partial(MVC.Shared.Views._Partial_PutAlexaCode)
	@Html.Partial(MVC.Shared.Views._Partial_PutGoogleCode)

	<meta http-equiv="content-type" content="text/html;charset=UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />

	@{
		string strTitle = "Iran Content - ايران محتوا";

		if (string.IsNullOrWhiteSpace(ViewBag.Title) == false)
		{
			strTitle = ViewBag.Title;
		}
		else
		{
			if (ViewContext.RouteData.Values["action"] != null)
			{
				strTitle =
					ViewContext.RouteData.Values["action"].ToString();
			}
		}

		<title>@(strTitle)</title>
	}

	@Html.Partial(MVC.Shared.Views._Partial_WriteMetaTagsForSearchEngines)

	<script src="~/Scripts/jquery-2.1.4.min.js"></script>
	<script src="~/Scripts/bootstrap.min.js"></script>

	<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
	<link href="~/Content/bootstrap-theme.min.css" rel="stylesheet" />
	<link href="~/Content/bootstrap-rtl.min.css" rel="stylesheet" />

	<link href="~/Content/_Layouts/home.fa-IR/Css/Site.css" rel="stylesheet" />

	@*دو دستور ذيل بايد در انتها نوشته شوند*@
	<link href="~/Content/SyntaxHighlighter/shCore.css" rel="stylesheet" />
	<link href="~/Content/SyntaxHighlighter/shThemeDefault.css" rel="stylesheet" />

	@if (IsSectionDefined(name: "headSection"))
	{
		@RenderSection(name: "headSection")
	}
</head>
<body>
	<nav class="navbar navbar-default" role="navigation" style="z-index: 1000;margin-bottom: 0;">
		<div class="container">
			<div class="navbar-header">
				<button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar">
					<span class="sr-only">Toggle navigation</span>
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
				</button>

				@{
					string strApplicationName =
						Infrastructure.ApplicationSettings.Instance.ApplicationName;

					if (string.IsNullOrWhiteSpace(strApplicationName))
					{
						strApplicationName =
							Resources.Captions.ApplicationName;
					}
				}

				<a class="navbar-brand" href="#">@strApplicationName</a>
			</div>

			<div id="navbar" class="navbar-collapse collapse">
				<ul class="nav navbar-nav navbar-right">
					<li>
						@Html.DtxActionLink(Resources.Actions.Home,
							MVC.Home.Index(),
							Infrastructure.Enums.ActionLinksTypes.SimpleLink)
					</li>
					<li>
						@Html.DtxActionLink(Resources.Models.User.EntitiesName,
							MVC.User.Index(),
							Infrastructure.Enums.ActionLinksTypes.SimpleLink)
					</li>
				</ul>

				<form id="frmSearch" class="navbar-form navbar-right" role="search" action="~/Home/Search">
					<div class="form-group">
						<input type="search" id="searchKeywords" name="searchKeywords" class="form-control" placeholder="جستجو" value="@(ViewBag.SearchKeywords)" />
					</div>
					<button type="submit" class="btn btn-default">
						<span class="glyphicon glyphicon-search" aria-hidden="true"></span>
					</button>
				</form>

				<ul class="nav navbar-nav navbar-left">
					@Html.Partial(MVC.Shared.Views._Partial_ChangeCulture)
				</ul>

				<ul class="nav navbar-nav navbar-left">
					@Html.Partial(MVC.Shared.Views._Partial_UserLoginStatus)
				</ul>
			</div>
		</div>
	</nav>

	<nav class="navbar navbar-default" role="navigation" style="z-index: 1000">
		<div class="container">
			<div class="navbar-header">
				<button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#subNavbar" aria-expanded="false" aria-controls="navbar">
					<span class="sr-only">Toggle navigation</span>
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
				</button>
			</div>

			<div id="subNavbar" class="navbar-collapse collapse" style="padding-left: 0; padding-right: 0;">
				<ul class="nav navbar-nav navbar-right" style="margin-right: -15px;">
					@Html.Partial(MVC.ECommerce.Shared.Views._Partial_DisplayMenuItems)

					@Html.Partial(MVC.Cms.Shared.Views._Partial_DisplayMenuItems)
				</ul>
			</div>
		</div>
	</nav>

	@Html.Partial(MVC.Shared.Views._Partial_DisplayMenu)

	<div class="container">
		<div id="carousel-example-generic" class="carousel slide" data-ride="carousel">
			<ol class="carousel-indicators">
				<li data-target="#carousel-example-generic" data-slide-to="0" class="active"></li>
				<li data-target="#carousel-example-generic" data-slide-to="1"></li>
				<li data-target="#carousel-example-generic" data-slide-to="2"></li>
			</ol>

			<div class="carousel-inner">
				<div class="item active">
					<img src="~/Content/_Layouts/home.fa-IR/Images/Banners/Banner01.jpg" alt="Slider" class="img-responsive" />
					<div class="carousel-caption">
					</div>
				</div>

				<div class="item">
					<img src="~/Content/_Layouts/home.fa-IR/Images/Banners/Banner02.jpg" alt="Slider" class="img-responsive" />
					<div class="carousel-caption">
					</div>
				</div>

				<div class="item">
					<img src="~/Content/_Layouts/home.fa-IR/Images/Banners/Banner03.jpg" alt="Slider" class="img-responsive" />
					<div class="carousel-caption">
					</div>
				</div>
			</div>

			<a class="left carousel-control" href="#carousel-example-generic" data-slide="prev">
				<span class="glyphicon glyphicon-chevron-left"></span>
			</a>
			<a class="right carousel-control" href="#carousel-example-generic" data-slide="next">
				<span class="glyphicon glyphicon-chevron-right"></span>
			</a>
		</div>

		<hr />
	</div>

	<div class="container">
		@Html.Partial(MVC.Shared.Views._Partial_DisplayLocalizedPageContent)
	</div>

	<div class="container">
		@Html.Partial(MVC.Shared.Views._Partial_DisplayPageMessages)

		@Html.Partial(MVC.Cms.Shared.Views._Partial_DisplayPostsOnHomePage)

		@RenderBody()
	</div>

	<br />
	<br />
	<br />
	<br />
	<br />
	<br />

	<nav class="navbar navbar-inverse navbar-fixed-bottom" role="navigation" style="z-index: 100">
		<div class="container">
			<div class="navbar-header">
				<button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbarBottom" aria-expanded="false" aria-controls="navbar">
					<span class="sr-only">Toggle navigation</span>
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
				</button>

				@Html.Partial(MVC.Shared.Views._Partial_DisplayCopyright)
			</div>

			<div id="navbarBottom" class="navbar-collapse collapse">
				<ul class="nav navbar-nav navbar-left">
					@Html.Partial(MVC.Shared.Views._Partial_DisplayRssLinks)

					<li>
						@Html.DtxActionLink(Resources.Actions.About,
							MVC.Home.About(),
							Infrastructure.Enums.ActionLinksTypes.SimpleLink)
					</li>
					<li>
						@Html.DtxActionLink(Resources.Actions.Contact,
							MVC.Home.Contact(),
							Infrastructure.Enums.ActionLinksTypes.SimpleLink)
					</li>
					<li>
						@Html.DtxActionLink(Resources.Actions.Help,
							MVC.Home.Help(),
							Infrastructure.Enums.ActionLinksTypes.SimpleLink)
					</li>
				</ul>
			</div>
		</div>
	</nav>

	<script src="~/Scripts/dtx-display-page-messages.js"></script>

	<script src="~/Scripts/SyntaxHighlighter/shCore.js"></script>
	<script src="~/Scripts/SyntaxHighlighter/shBrushCss.js"></script>
	<script src="~/Scripts/SyntaxHighlighter/shBrushSql.js"></script>
	<script src="~/Scripts/SyntaxHighlighter/shBrushXml.js"></script>
	<script src="~/Scripts/SyntaxHighlighter/shBrushCSharp.js"></script>

	<script src="~/Content/_Layouts/home.fa-IR/Scripts/custom.js"></script>
</body>
</html>
