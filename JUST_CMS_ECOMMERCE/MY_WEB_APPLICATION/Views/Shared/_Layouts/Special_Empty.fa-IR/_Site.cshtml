<!doctype html>
<html lang="fa">
<head>
	<meta charset="utf-8">

	<link href="~/favicon.ico" rel="shortcut icon" />

	@Html.Partial(MVC.Shared.Views._Partial_PutAlexaCode)
	@Html.Partial(MVC.Shared.Views._Partial_PutGoogleCode)

	<!--[if IE]>
		<meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1">
	<![endif]-->
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta http-equiv="content-type" content="text/html;charset=UTF-8" />

	@{
		string strTitle = "ALPA - آلپا";

		if (string.IsNullOrWhiteSpace(ViewBag.Title) == false)
		{
			strTitle = ViewBag.Title;
		}
		else
		{
			if (ViewContext.RouteData.Values["action"] != null)
			{
				strTitle =
					ViewContext.RouteData.Values["action"].ToString();
			}
		}

		<title>@(strTitle)</title>
	}

	@Html.Partial(MVC.Shared.Views._Partial_WriteMetaTagsForSearchEngines)

	<!-- Bootstrap Core CSS -->
	<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
	<link href="~/Content/bootstrap-rtl.min.css" rel="stylesheet" />

	<link href="~/Content/kendo/lastVersion/kendo.common-bootstrap.min.css" rel="stylesheet" />
	<link href="~/Content/kendo/lastVersion/kendo.bootstrap.min.css" rel="stylesheet" />
	<link href="~/Content/kendo/lastVersion/kendo.rtl.min.css" rel="stylesheet" />

	<!-- CSS Files -->
	<link href="~/Content/_Layouts/Special.fa-IR/Css/owl.carousel.css" rel="stylesheet" />
	<link href="~/Content/_Layouts/Special.fa-IR/Css/style.css" rel="stylesheet" />
	<link href="~/Content/_Layouts/Special.fa-IR/Css/responsive.css" rel="stylesheet" />

	<link href="~/Content/_Layouts/Special.fa-IR/Site.css" rel="stylesheet" />

	<!--[if lt IE 9]>
		<script src="js/ie8-responsive-file-warning.js"></script>
	<![endif]-->
	<!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
	<!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
	<!--[if lt IE 9]>
	<script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
	<script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
	<![endif]-->
	<!-- JavaScript Files Starts -->
	<script src="~/Scripts/jquery-2.1.4.min.js"></script>
	<script src="~/Scripts/bootstrap.min.js"></script>
	<!-- JavaScript Files Ends -->
	@if (IsSectionDefined(name: "headSection"))
	{
		@RenderSection(name: "headSection")
	}
</head>
<body>
	<!-- Wrapper Starts -->
	<div id="wrapper" class="container">

		<!-- Header Section Starts -->
		<header id="header-area">

			<!-- Nested Row Starts -->
			<div class="row">

				<!-- Logo Starts -->
				<div class="col-md-4 col-xs-12">
					<div id="logo">
						<a href="/Home/Index">
							<img src="~/Content/_Layouts/Special.fa-IR/Images/Logo.png" width="80" alt="Alpa" title="Alpa" class="img-responsive" />
						</a>
					</div>
				</div>
				<!-- Logo Ends -->
				<!-- Header Right Starts -->
				<div class="col-md-8 col-xs-12">

					<div class="row">
						<!-- Search Starts -->
						<div class="col-md-7 col-xs-12">
							<div id="search">
								<form action="~/Home/Search">
									<div class="input-group">
										<input type="text" id="searchKeywords" name="searchKeywords" class="form-control input-lg" placeholder="جستجو" value="@(ViewBag.SearchKeywords)" />
										<span class="input-group-btn">
											<button type="submit" class="btn btn-lg">
												<span class="glyphicon glyphicon-search" aria-hidden="true"></span>
											</button>
										</span>
									</div>
								</form>
							</div>
						</div>
						<!-- Search Ends -->
						<!-- Shopping Cart Starts -->
						<div class="col-md-5 col-xs-12">
						</div>
						<!-- Shopping Cart Ends -->
					</div>
				</div>
				<!-- Header Right Ends -->
			</div>
			<!-- Nested Row Ends -->
		</header>
		<!-- Header Section Ends -->
		@Html.Partial(MVC.Shared.Views._Partial_DisplayMenu)

		@Html.Partial(MVC.Shared.Views._Partial_DisplayLocalizedPageContent)

		@Html.Partial(MVC.Shared.Views._Partial_DisplayPageMessages)

		@RenderBody()

		<!-- Footer Section Starts -->
		<footer id="footer-area">
			<!-- Footer Links Starts -->
			<div class="footer-links row">
				<!-- Information Links Starts -->
				<div class="col-md-3 col-sm-6">
					<h5>اطلاعات</h5>
					<ul>
						<li>@Html.DtxActionLink("راهنما", MVC.Home.Help(), Infrastructure.Enums.ActionLinksTypes.SimpleLink)</li>
						<li>@Html.DtxActionLink("درباره ما", MVC.Home.About(), Infrastructure.Enums.ActionLinksTypes.SimpleLink)</li>
						<li>@Html.DtxActionLink("تماس با ما", MVC.Home.Contact(), Infrastructure.Enums.ActionLinksTypes.SimpleLink)</li>
					</ul>
				</div>
				<!-- Contact Us Starts -->
				<div class="col-md-9 col-sm-6 last">
					<h5>نشانی و اطلاعات تماس</h5>
					<ul>
						<li>شرکت آلپا</li>
						<li>
							تهران، اميرآباد شمالی، پايين تر از پمپ بنزين، کوچه اکبری، سهند غربی، پلاک سيزده
						</li>
						<li>
							نشانی پست الکترونيکی: <a href="mailto:Info@AlpaGroup.net">Sales@AlpaGroup.net</a>
						</li>
					</ul>
					<h4 class="lead">
						تلفن های تماس:
						<br />
						<span>(76091)-(889) (21) (98+)</span>
						<br />
						<span>(76092)-(889) (21) (98+)</span>
						<br />
						<span>(76093)-(889) (21) (98+)</span>
						<br />
						<span>(76094)-(889) (21) (98+)</span>
						<br />
						نمابر:
						<br />
						<span>(76095)-(889) (21) (98+)</span>
					</h4>
				</div>
				<!-- Contact Us Ends -->
			</div>
			<!-- Footer Links Ends -->
		</footer>
		<!-- Footer Section Ends -->
	</div>
	<!-- Wrapper Ends -->
	<!-- Copyright Area Starts -->
	<div class="copyright container">
		<div class="clearfix">
			<!-- Starts -->
			<p class="pull-right">
				@{
					string strCopyrightAndVersion = string.Empty;

					if (string.IsNullOrWhiteSpace(Infrastructure.ApplicationSettings.Instance.ApplicationCopyrightText) == false)
					{
						strCopyrightAndVersion =
							Infrastructure.ApplicationSettings.Instance.ApplicationCopyrightText;
					}

					if (string.IsNullOrWhiteSpace(Infrastructure.ApplicationSettings.Instance.ApplicationVersion) == false)
					{
						string strVersion =
							Dtx.Text.Convert.DigitsToUnicode
							(Infrastructure.ApplicationSettings.Instance.ApplicationVersion);

						strCopyrightAndVersion =
							string.Format("{0} ({1}: {2})", strCopyrightAndVersion, Resources.Captions.Version, strVersion);
					}
				}

				@strCopyrightAndVersion
			</p>
			<!-- Ends -->
		</div>
	</div>
	<!-- Copyright Area Ends -->
	<!-- JavaScript Files Starts -->
	<script src="~/Scripts/kendo/lastVersion/kendo.all.min.js"></script>
	<script src="~/Scripts/kendo/lastVersion/cultures/kendo.culture.fa-IR.min.js"></script>
	<script src="~/Scripts/kendo/kendo.fa-IR.js"></script>

	<script src="~/Content/_Layouts/Special.fa-IR/Scripts/bootstrap-hover-dropdown.min.js"></script>
	<script src="~/Content/_Layouts/Special.fa-IR/Scripts/jquery.magnific-popup.min.js"></script>
	<script src="~/Content/_Layouts/Special.fa-IR/Scripts/owl.carousel.min.js"></script>
	<script src="~/Content/_Layouts/Special.fa-IR/Scripts/custom.js"></script>

	<script src="~/Scripts/jquery.validate.min.js"></script>
	<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

	<script src="~/Scripts/dtx-required.js"></script>
	<script src="~/Scripts/dtx-display-page-messages.js"></script>
	<!-- JavaScript Files Ends -->
</body>
</html>
