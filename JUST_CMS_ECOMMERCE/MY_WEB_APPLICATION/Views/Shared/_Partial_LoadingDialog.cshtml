<div id="myLoadingDialog" class="modal fade" style="z-index: 3000000" tabindex="-1" role="dialog" aria-labelledby="myLoadingDialogLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title" id="myLoadingDialogLabel">@Resources.Captions.Loading</h4>
			</div>
			<div class="modal-body">
				<img src="~/Content/Images/Loading.gif" alt="Loading..." title="Loading..." />
				@Resources.Captions.PleaseWait
			</div>
		</div>
	</div>
</div>
