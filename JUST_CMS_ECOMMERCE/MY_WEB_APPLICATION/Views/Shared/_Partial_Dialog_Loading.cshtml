<div id="loadingDialog" style="z-index: 3000" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="loadingDialogLabel" aria-hidden="true">

	<div class="modal-dialog">
		<div class="modal-content">

			<div class="modal-header">
				<h4 class="modal-title" id="loadingDialogLabel">
					@Resources.Captions.Loading
				</h4>
			</div>

			<div class="modal-body">
				<img src="~/Content/Images/Loading.gif" alt="Loading..." title="Loading..." />
				@Resources.Captions.PleaseWait
			</div>

		</div>
	</div>

</div>
