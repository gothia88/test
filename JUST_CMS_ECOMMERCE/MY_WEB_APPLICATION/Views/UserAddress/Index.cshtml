@model IEnumerable<Models.UserAddress>

@{
	string strTitle =
		string.Format("{0} {1}",
		Resources.Actions.ListOf,
		Resources.Models.UserAddress.EntitiesName);

	ViewBag.Title = strTitle;
}

@Html.DtxBeginPanel()

@Html.DtxBeginPanelHeading()
@Html.DtxPanelTitle(strTitle)
@Html.DtxEndPanelHeading()

@Html.DtxBeginPanelBody()
@{
	string strCreate =
		string.Format("{0} {1}",
		Resources.Actions.CreateOf,
		Resources.Models.UserAddress.EntityName);
}

@Html.DtxActionLink(strCreate,
	MVC.UserAddress.Create())

<br />
<br />

<div class="table-responsive">
	<table class="table table-striped table-bordered table-hover table-condensed">
		<tr>
			<th style="width: 70px;">
				&nbsp;
			</th>
			<th style="width: 90px;">
				@Html.DisplayNameFor(model => model.IsPublic)
			</th>
			<th style="width: 70px;">
				@Html.DisplayNameFor(model => model.Title)
			</th>
			<th style="width: 70px;">
				@Html.DisplayNameFor(model => model.Address)
			</th>
			<th style="width: 70px;">
				@Html.DisplayNameFor(model => model.PhoneNumbers)
			</th>
		</tr>

		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DtxActionLink(Resources.Actions.Details,
						MVC.UserAddress.Details(item.Id),
						Infrastructure.Enums.ActionLinksTypes.Details)

					@Html.DtxActionLink(Resources.Actions.Edit,
						MVC.UserAddress.Edit(item.Id),
						Infrastructure.Enums.ActionLinksTypes.Edit)

					@Html.DtxActionLink(Resources.Actions.Delete,
						MVC.UserAddress.Delete(item.Id),
						Infrastructure.Enums.ActionLinksTypes.Delete)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.IsPublic)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Title)
				</td>
				<td>
					@Html.Raw(item.Address)
				</td>
				<td>
					@Html.Raw(item.PhoneNumbers)
				</td>
			</tr>
		}
	</table>
</div>
@Html.DtxEndPanelBody()

@*
	@Html.DtxBeginPanelFooter()
	@Html.DtxEndPanelFooter()
*@

@Html.DtxEndPanel()
