@model Models.UserAddress

@{
	string strTitle =
		string.Format("{0} {1}",
		Resources.Actions.CreateOf,
		Resources.Models.UserAddress.EntityName);

	ViewBag.Title = strTitle;
}

@using (Html.BeginForm())
{
	@Html.AntiForgeryToken()

	@Html.DtxBeginPanel()

	@Html.DtxBeginPanelHeading()
	@Html.DtxPanelTitle(strTitle)
	@Html.DtxEndPanelHeading()

	@Html.DtxBeginPanelBody()
	@Html.ValidationSummary(excludePropertyErrors: true)

	@Html.DtxCheckBoxFor(model => model.IsPublic)

	@Html.DtxLabelTextBoxFor(model => model.Title, hint: "مثال: منزل، محل کار، منزل پدر،...")

	@Html.DtxLabelTextAreaFor(model => model.Address)

	@Html.DtxLabelTextAreaFor(model => model.PhoneNumbers)

	@Html.DtxSubmit(Resources.Buttons.Create)
	@Html.DtxEndPanelBody()

	@Html.DtxBeginPanelFooter()
	@Html.DtxActionLink(Resources.Actions.BackToList,
		MVC.UserAddress.Index())
	@Html.DtxEndPanelFooter()

	@Html.DtxEndPanel()
}
