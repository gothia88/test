@model Models.User

@{
	string strTitle =
		Resources.Actions.UploadResume;

	ViewBag.Title = strTitle;
}

@using (Html.BeginForm("UploadResume", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
	@Html.AntiForgeryToken()

	@Html.DtxBeginPanel()

	@Html.DtxBeginPanelHeading()
	@Html.DtxPanelTitle(strTitle)
	@Html.DtxEndPanelHeading()

	@Html.DtxBeginPanelBody()
	@Html.ValidationSummary(excludePropertyErrors: true)

	<div class="form-group">
		<label for="fileContent" class="control-label">@Resources.Models.User.Resume</label>
		<div class="col-sm-10">
			<input type="file" id="fileContent" name="fileContent" />
		</div>
	</div>

	if (Model.HasResume)
	{
		<div class="form-group">
			<div class="col-sm-10">
				@Html.DtxActionLink(Resources.Actions.DownloadResume,
					MVC.Account.DownloadResume(Model.Id))
			</div>
		</div>
	}

	@Html.DtxSubmit(Resources.Buttons.Send)
	@Html.DtxEndPanelBody()

	@*
		@Html.DtxBeginPanelFooter()
		@Html.DtxEndPanelFooter()
	*@

	@Html.DtxEndPanel()
}
