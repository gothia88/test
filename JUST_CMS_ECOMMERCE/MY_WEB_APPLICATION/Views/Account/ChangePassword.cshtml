@model ViewModels.Account.ChangePasswordViewModel

@{
	string strTitle =
		Resources.Actions.ChangePassword;

	ViewBag.Title = strTitle;
}

@using (Html.BeginForm())
{
	@Html.AntiForgeryToken()

	@Html.DtxBeginPanel()

	@Html.DtxBeginPanelHeading()
	@Html.DtxPanelTitle(strTitle)
	@Html.DtxEndPanelHeading()

	@Html.DtxBeginPanelBody()
	@Html.ValidationSummary(excludePropertyErrors: true)

	@Html.DtxLabelPasswordFor(model => model.CurrentPassword)

	@Html.DtxLabelPasswordFor(model => model.NewPassword)

	@Html.DtxLabelPasswordFor(model => model.ConfirmNewPassword)

	@Html.DtxSubmit(Resources.Buttons.Save)
	@Html.DtxEndPanelBody()

	@*
		@Html.DtxBeginPanelFooter()
		@Html.DtxEndPanelFooter()
	*@

	@Html.DtxEndPanel()
}
