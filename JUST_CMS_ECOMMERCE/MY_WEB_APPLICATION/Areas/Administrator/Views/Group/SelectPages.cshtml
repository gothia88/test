@model Models.Group

@{
	string strTitle =
		string.Format("{0} {1}",
		Resources.Actions.SelectPagesOf,
		Resources.Models.Group.EntityName);

	ViewBag.Title =
		string.Format("{0} ({1})", strTitle, Model.Name);
}

<script>
	$(document).ready(function () {

		$("a.selectAll").click(function (e) {

			e.preventDefault();

			var varCheckBoxes =
				$(this).nextAll('ul').first().find("input[type='checkbox']");

			$(varCheckBoxes).each(function (e) {
				this.checked = true;
			});
		});

		$("a.deselectAll").click(function (e) {

			e.preventDefault();

			var varCheckBoxes =
				$(this).nextAll('ul').first().find("input[type='checkbox']");

			$(varCheckBoxes).each(function (e) {
				this.checked = false;
			});
		});
	});
</script>

@{
	var varPages =
		(IEnumerable<Models.Cms.Page>)ViewBag.Pages;

	DAL.UnitOfWork oUnitOfWork = new DAL.UnitOfWork();
}

@using (Html.BeginForm())
{
	@Html.AntiForgeryToken()

	<input type="hidden" id="id" value="@Model.Id" />

	@Html.DtxBeginPanel()

	@Html.DtxBeginPanelHeading()
	@Html.DtxPanelTitle(strTitle)
	@Html.DtxEndPanelHeading()

	@Html.DtxBeginPanelBody()
	@Html.ValidationSummary(excludePropertyErrors: true)

	<div class="form-group">
		<br />
		<a class="btn btn-warning btn-sm selectAll">انتخاب همه</a>
		<a class="btn btn-warning btn-sm deselectAll">خارج کردن همه از حالت انتخاب شده</a>
		<br />
		<br />

		@Html.Raw("<ul>")

		@foreach (Models.Cms.Page oPage in varPages)
		{
			@Html.Raw("<li>")

			bool blnChecked = false;

			foreach (Models.Cms.Page oCurrentPage in Model.Pages)
			{
				if (oPage.Id == oCurrentPage.Id)
				{
					blnChecked = true;
					break;
				}
			}

			if (blnChecked)
			{
				if (oPage.Layout == null)
				{
					<input type="checkbox" name="checkBoxes" value="@oPage.Id" checked="checked" />
					@oPage.Title
					<text>(</text>
					@oPage.Name
					<text>)</text>
				}
				else
				{
					<input type="checkbox" name="checkBoxes" value="@oPage.Id" checked="checked" />
					@oPage.Title
					<text>(</text>
					@oPage.Name
					<text>)</text>
				}
			}
			else
			{
				if (oPage.Layout == null)
				{
					<input type="checkbox" name="checkBoxes" value="@oPage.Id" />
					@oPage.Title
					<text>(</text>
					@oPage.Name
					<text>)</text>
				}
				else
				{
					<input type="checkbox" name="checkBoxes" value="@oPage.Id" />
					@oPage.Title
					<text>(</text>
					@oPage.Name
					<text>)</text>
				}
			}

			@Html.Raw("</li>")
		}

		@Html.Raw("</ul>")
	</div>

	@Html.DtxSubmit(Resources.Buttons.Save)
	@Html.DtxEndPanelBody()

	@Html.DtxBeginPanelFooter()
	@Html.DtxActionLink(Resources.Controllers.Administrator_Group,
		MVC.Administrator.Group.Index())
	@Html.DtxEndPanelFooter()

	@Html.DtxEndPanel()
}
