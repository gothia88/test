@model IEnumerable<ViewModels.Areas.Administrator.Group.IndexViewModel>

@{
	string strTitle =
		string.Format("{0} {1}",
		Resources.Actions.ListOf,
		Resources.Models.Group.EntitiesName);

	ViewBag.Title = strTitle;
}

@Html.DtxBeginPanel()

@Html.DtxBeginPanelHeading()
@Html.DtxPanelTitle(strTitle)
@Html.DtxEndPanelHeading()

@Html.DtxBeginPanelBody()
@{
	string strCreate =
		string.Format("{0} {1}",
		Resources.Actions.CreateOf,
		Resources.Models.Group.EntityName);
}

@Html.DtxActionLink(strCreate,
	MVC.Administrator.Group.Create())

<br />
<br />

<div class="table-responsive">
	<table class="table table-striped table-bordered table-hover table-condensed">
		<tr>
			<th style="width: 150px;">
				&nbsp;
			</th>
			<th style="width: 75px;">
				@Html.DisplayNameFor(model => model.IsActive)
			</th>
			<th style="width: 75px;">
				@Html.DisplayNameFor(model => model.Ordering)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Name)
			</th>
			<th style="width: 120px;">
				@Html.DisplayNameFor(model => model.UserCount)
			</th>
			<th style="width: 120px;">
				@Html.DisplayNameFor(model => model.ProjectActionCount)
			</th>
			<th style="width: 120px;">
				@Html.DisplayNameFor(model => model.PageCount)
			</th>
			<th style="width: 160px;">
				@Resources.Models.General.InsertAndUpdateDateTime
			</th>
		</tr>

		@foreach (var item in Model)
		{
			string strRowStyle =
				Infrastructure.Utility.GetRowStyle(item);

			<tr class="@strRowStyle">
				<td>
					@Html.DtxActionLink(Resources.Actions.Details,
						MVC.Administrator.Group.Details(item.Id),
						Infrastructure.Enums.ActionLinksTypes.Details)

					@Html.DtxActionLink(Resources.Actions.Edit,
						MVC.Administrator.Group.Edit(item.Id),
						Infrastructure.Enums.ActionLinksTypes.Edit)

					@if ((item.PageCount == 0) &&
						(item.UserCount == 0) &&
						(item.ProjectActionCount == 0))
					{
						@Html.DtxActionLink(Resources.Actions.Delete,
							MVC.Administrator.Group.Delete(item.Id),
							Infrastructure.Enums.ActionLinksTypes.Delete)
					}

					<br />
					@Html.DtxActionLink(Resources.Actions.SelectPagesForGroup,
						MVC.Administrator.Group.SelectPages(item.Id))
					<br />
					@Html.DtxActionLink(Resources.Actions.SelectProjectActionsForGroup,
						MVC.Administrator.Group.SelectProjectActions(item.Id))
				</td>

				<td>
					@Html.DisplayFor(modelItem => item.IsActive)
				</td>
				<td>
					@Dtx.Text.Convert.DisplayFormattedNumber(item.Ordering)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Name)
				</td>
				<td>
					@Dtx.Text.Convert.DisplayFormattedNumber(item.UserCount)
				</td>
				<td>
					@Dtx.Text.Convert.DisplayFormattedNumber(item.ProjectActionCount)
				</td>
				<td>
					@Dtx.Text.Convert.DisplayFormattedNumber(item.PageCount)
				</td>
				<td>
					@Html.DisplayDateTime(item.InsertDateTime, displayTime: true)
					<br />
					@Html.DisplayDateTime(item.UpdateDateTime, displayTime: true)
				</td>
			</tr>
		}
	</table>
</div>
@Html.DtxEndPanelBody()

@*
	@Html.DtxBeginPanelFooter()
	@Html.DtxEndPanelFooter()
*@

@Html.DtxEndPanel()
