@model IEnumerable<Models.AccessType>

@{
	string strTitle =
		string.Format("{0} {1}",
		Resources.Actions.ListOf,
		Resources.Models.AccessType.EntitiesName);

	ViewBag.Title = strTitle;
}

@Html.DtxBeginPanel()

@Html.DtxBeginPanelHeading()
@Html.DtxPanelTitle(strTitle)
@Html.DtxEndPanelHeading()

@Html.DtxBeginPanelBody()
<div class="table-responsive">
	<table class="table table-striped table-bordered table-hover table-condensed">
		<tr>
			<th style="width: 70px;">
				&nbsp;
			</th>
			<th style="width: 70px;">
				@Html.DisplayNameFor(model => model.IsActive)
			</th>
			<th style="width: 70px;">
				@Html.DisplayNameFor(model => model.Ordering)
			</th>
			<th style="width: 100px;">
				@Html.DisplayNameFor(model => model.Code)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Name)
			</th>
			<th style="width: 160px;">
				@Resources.Models.General.InsertAndUpdateDateTime
			</th>
		</tr>

		@foreach (var item in Model)
		{
			string strRowStyle =
				Infrastructure.Utility.GetRowStyle(item);

			<tr class="@strRowStyle">
				<td>
					@Html.DtxActionLink(Resources.Actions.Details,
						MVC.Administrator.AccessType.Details(item.Id),
						Infrastructure.Enums.ActionLinksTypes.Details)

					@Html.DtxActionLink(Resources.Actions.Edit,
						MVC.Administrator.AccessType.Edit(item.Id),
						Infrastructure.Enums.ActionLinksTypes.Edit)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.IsActive)
				</td>
				<td>
					@Dtx.Text.Convert.DisplayFormattedNumber(item.Ordering)
				</td>
				<td>
					@Dtx.Text.Convert.DisplayFormattedNumber(item.Code)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Name)
				</td>
				<td>
					@Html.DisplayDateTime(item.InsertDateTime, displayTime: true)
					<br />
					@Html.DisplayDateTime(item.UpdateDateTime, displayTime: true)
				</td>
			</tr>
		}
	</table>
</div>
@Html.DtxEndPanelBody()

@Html.DtxEndPanel()
