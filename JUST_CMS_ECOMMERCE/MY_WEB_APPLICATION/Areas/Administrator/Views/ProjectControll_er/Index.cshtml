@model IEnumerable<ViewModels.Areas.Administrator.ProjectController.IndexViewModel>

@{
	Models.ProjectArea oProjectArea =
		ViewBag.ProjectArea as Models.ProjectArea;

	string strTitle =
		string.Format("{0} {1} {2}",
		Resources.Actions.ListOf,
		Resources.Models.ProjectController.EntitiesNameOf,
		oProjectArea.DisplayName);

	ViewBag.Title = strTitle;
}

@Html.DtxBeginPanel()

@Html.DtxBeginPanelHeading()
@Html.DtxPanelTitle(strTitle)
@Html.DtxEndPanelHeading()

@Html.DtxBeginPanelBody()
@Html.DtxActionLink(Resources.Actions.ListOf + " " +
	Resources.Models.ProjectArea.EntitiesName,
	MVC.Administrator.ProjectArea.Index())

@if (Infrastructure.Sessions.AuthenticatedUser.Role == Models.Enums.Roles.Programmer)
{
	string strCreate =
		string.Format("{0} {1}",
		Resources.Actions.CreateOf,
		Resources.Models.ProjectController.EntityName);

	@Html.DtxActionLink(strCreate,
		MVC.Administrator.ProjectControll_er.Create(oProjectArea.Id))
}

<br />
<br />

<div class="table-responsive">
	<table class="table table-striped table-bordered table-hover table-condensed">
		<tr>
			<th style="width: 120px;">
				&nbsp;
			</th>
			<th style="width: 80px;">
				@Html.DisplayNameFor(model => model.IsActive)
			</th>
			<th style="width: 80px;">
				@Html.DisplayNameFor(model => model.Ordering)
			</th>

			@if (Infrastructure.Sessions.AuthenticatedUser.Role == Models.Enums.Roles.Programmer)
			{
				<th style="width: 150px;">
					@Html.DisplayNameFor(model => model.IsVisibleJustForProgrammer)
				</th>
				<th style="width: 150px;">
					@Html.DisplayNameFor(model => model.Name)
				</th>
			}

			<th>
				@Html.DisplayNameFor(model => model.DisplayName)
			</th>
			<th style="width: 80px;">
				@Resources.Models.ProjectController.ProjectActionCount
			</th>
			<th style="width: 160px;">
				@Resources.Models.General.InsertAndUpdateDateTime
			</th>
		</tr>

		@foreach (var item in Model)
		{
			string strRowStyle =
				Infrastructure.Utility.GetRowStyle(item);

			<tr class="@strRowStyle">
				<td>
					@Html.DtxActionLink(Resources.Actions.Details,
						MVC.Administrator.ProjectControll_er.Details(item.Id),
						Infrastructure.Enums.ActionLinksTypes.Details)

					@Html.DtxActionLink(Resources.Actions.Edit,
						MVC.Administrator.ProjectControll_er.Edit(item.Id),
						Infrastructure.Enums.ActionLinksTypes.Edit)

					@if ((item.ProjectActionCount == 0) &&
						(Infrastructure.Sessions.AuthenticatedUser.Role == Models.Enums.Roles.Programmer))
					{
						@Html.DtxActionLink(Resources.Actions.Delete,
							MVC.Administrator.ProjectControll_er.Delete(item.Id),
							Infrastructure.Enums.ActionLinksTypes.Delete)
					}

					<br />
					@Html.DtxActionLink(Resources.Actions.ListOf + " " +
						Resources.Models.ProjectAction.EntitiesName,
						MVC.Administrator.ProjectAction.Index(item.Id))
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.IsActive)
				</td>
				<td>
					@Dtx.Text.Convert.DisplayFormattedNumber(item.Ordering)
				</td>

				@if (Infrastructure.Sessions.AuthenticatedUser.Role == Models.Enums.Roles.Programmer)
				{
					<td>
						@Html.DisplayFor(modelItem => item.IsVisibleJustForProgrammer)
					</td>
					<td style="direction: ltr">
						@Html.DisplayFor(modelItem => item.Name)
					</td>
				}

				<td>
					@Html.DisplayFor(modelItem => item.DisplayName)
				</td>
				<td>
					@Dtx.Text.Convert.DisplayFormattedNumber(item.ProjectActionCount)
				</td>
				<td>
					@Html.DisplayDateTime(item.InsertDateTime, displayTime: true)
					<br />
					@Html.DisplayDateTime(item.UpdateDateTime, displayTime: true)
				</td>
			</tr>
		}
	</table>
</div>
@Html.DtxEndPanelBody()

@*
	@Html.DtxBeginPanelFooter()
	@Html.DtxEndPanelFooter()
*@

@Html.DtxEndPanel()
