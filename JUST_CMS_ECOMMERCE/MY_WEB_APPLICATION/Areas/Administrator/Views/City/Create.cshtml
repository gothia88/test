@model Models.City

@{
	Models.State oState =
		ViewBag.State as Models.State;

	string strTitle =
		string.Format("{0} {1}",
		Resources.Actions.CreateOf,
		Resources.Models.City.EntityName);

	ViewBag.Title = strTitle;
}

@Html.DtxBeginPanel()

@Html.DtxBeginPanelHeading()
@Html.DtxPanelTitle(@Resources.Models.Country.EntityName)
@Html.DtxEndPanelHeading()

@Html.DtxBeginPanelBody()
@Html.DtxActionLink(oState.Country.Name,
	MVC.Administrator.Country.Details(oState.CountryId))
@Html.DtxEndPanelBody()

@Html.DtxBeginPanelFooter()
@Html.DtxActionLink(Resources.Models.Country.EntitiesName,
	MVC.Administrator.Country.Index())
@Html.DtxEndPanelFooter()

@Html.DtxEndPanel()

@Html.DtxBeginPanel()

@Html.DtxBeginPanelHeading()
@Html.DtxPanelTitle(Resources.Models.State.EntityName)
@Html.DtxEndPanelHeading()

@Html.DtxBeginPanelBody()
@Html.DtxActionLink(oState.Name,
	MVC.Administrator.State.Details(oState.Id))
@Html.DtxEndPanelBody()

@Html.DtxBeginPanelFooter()
@Html.DtxActionLink(Resources.Models.State.EntitiesName,
	MVC.Administrator.State.Index(oState.CountryId))
@Html.DtxEndPanelFooter()

@Html.DtxEndPanel()

@using (Html.BeginForm())
{
	@Html.AntiForgeryToken()

	@Html.HiddenFor(model => model.StateId)

	@Html.DtxBeginPanel()

	@Html.DtxBeginPanelHeading()
	@Html.DtxPanelTitle(strTitle)
	@Html.DtxEndPanelHeading()

	@Html.DtxBeginPanelBody()
	@Html.ValidationSummary(excludePropertyErrors: true)

	@Html.DtxCheckBoxFor(model => model.IsActive)

	@Html.DtxLabelTextBoxFor(model => model.Ordering, leftToRight: true)

	@Html.DtxLabelTextBoxFor(model => model.MasterDataCode, leftToRight: true)

	@Html.DtxLabelTextBoxFor(model => model.Name)

	@Html.DtxSubmit(Resources.Buttons.Create)
	@Html.DtxEndPanelBody()

	@Html.DtxBeginPanelFooter()
	@Html.DtxActionLink(Resources.Actions.BackToList,
		MVC.Administrator.City.Index(oState.Id))
	@Html.DtxEndPanelFooter()

	@Html.DtxEndPanel()
}
