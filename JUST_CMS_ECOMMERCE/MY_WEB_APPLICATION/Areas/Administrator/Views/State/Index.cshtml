@model IEnumerable<Models.State>

@{
	Models.Country oCountry =
		ViewBag.Country as Models.Country;

	string strTitle =
		string.Format("{0} {1}",
		Resources.Actions.ListOf,
		Resources.Models.State.EntitiesName);

	ViewBag.Title = strTitle;
}

@Html.DtxBeginPanel()

@Html.DtxBeginPanelHeading()
@Html.DtxPanelTitle(Resources.Models.Country.EntityName)
@Html.DtxEndPanelHeading()

@Html.DtxBeginPanelBody()
@Html.DtxActionLink(oCountry.Name,
	MVC.Administrator.Country.Details(oCountry.Id))
@Html.DtxEndPanelBody()

@Html.DtxBeginPanelFooter()
@Html.DtxActionLink(Resources.Models.Country.EntitiesName,
	MVC.Administrator.Country.Index())
@Html.DtxEndPanelFooter()

@Html.DtxEndPanel()

@Html.DtxBeginPanel()

@Html.DtxBeginPanelHeading()
@Html.DtxPanelTitle(strTitle)
@Html.DtxEndPanelHeading()

@Html.DtxBeginPanelBody()
@{
	string strCreate =
		string.Format("{0} {1}",
		Resources.Actions.CreateOf,
		Resources.Models.State.EntityName);
}

@Html.DtxActionLink(strCreate,
	MVC.Administrator.State.Create(oCountry.Id))

<br />
<br />

<div class="table-responsive">
	<table class="table table-striped table-bordered table-hover table-condensed">
		<tr>
			<th style="width: 100px;">
				&nbsp;
			</th>
			<th style="width: 100px;">
				@Html.DisplayNameFor(model => model.IsActive)
			</th>
			<th style="width: 100px;">
				@Html.DisplayNameFor(model => model.Ordering)
			</th>
			<th style="width: 100px;">
				@Html.DisplayNameFor(model => model.MasterDataCode)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Name)
			</th>
			<th style="width: 200px;">
				@Resources.Models.General.InsertAndUpdateDateTime
			</th>
		</tr>

		@foreach (var item in Model)
		{
			string strRowStyle =
				Infrastructure.Utility.GetRowStyle(item);

			<tr class="@strRowStyle">
				<td>
					@Html.DtxActionLink(Resources.Actions.Details,
						MVC.Administrator.State.Details(item.Id),
						Infrastructure.Enums.ActionLinksTypes.Details)

					@Html.DtxActionLink(Resources.Actions.Edit,
						MVC.Administrator.State.Edit(item.Id),
						Infrastructure.Enums.ActionLinksTypes.Edit)

					@Html.DtxActionLink(Resources.Actions.Delete,
						MVC.Administrator.State.Delete(item.Id),
						Infrastructure.Enums.ActionLinksTypes.Delete)
					<br />
					@Html.DtxActionLink(Resources.Models.City.EntitiesName,
						MVC.Administrator.City.Index(item.Id))
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.IsActive)
				</td>
				<td>
					@Dtx.Text.Convert.DisplayFormattedNumber(item.Ordering)
				</td>
				<td>
					@Dtx.Text.Convert.DisplayFormattedNumber(item.MasterDataCode)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Name)
				</td>
				<td>
					@Html.DisplayDateTime(item.InsertDateTime, displayTime: true)
					<br />
					@Html.DisplayDateTime(item.UpdateDateTime, displayTime: true)
				</td>
			</tr>
		}
	</table>
</div>
@Html.DtxEndPanelBody()

@*
	@Html.DtxBeginPanelFooter()
	@Html.DtxEndPanelFooter()
*@

@Html.DtxEndPanel()
