@model ViewModels.Areas.ECommerce.Transaction.UserSearchViewModel

@{
	string strTitle =
		string.Format("{0} {1}",
		Resources.Actions.ListOf,
		Resources.Models.ECommerce.Transaction.EntitiesName);

	ViewBag.Title = strTitle;
}

<script type="text/javascript">

	$(document).ready(function () {

		// **************************************************
		$("div#divSearch").dblclick(function(e){

			$(this).next().slideToggle();

		});
		// **************************************************

		// **************************************************
		var varDataSourceSettings = {

			pageSize: 10,

			serverPaging: true,
			serverSorting: true,
			serverGrouping: false,
			serverFiltering: false,
			serverAggregates: false,

			transport: {

				read: {

					data: null,
					type: "POST",
					dataType: "json",
					url: "/ECommerce/Transaction/GetDataForUser",

				},

			},

			requestStart: function(e) {

				$("button#btnReset").hide();
				$("button#btnSearch").hide();

			},

			requestEnd: function(e) {

				$("button#btnReset").show();
				$("button#btnSearch").show();

			},

			schema: {

				data: function (e) {

					return (e.Data);

				},
				total: function (e) {

					return (e.Total);

				},

			},

		};
		// **************************************************

		// **************************************************
		var varDataSource =
			new kendo.data.DataSource(varDataSourceSettings);
		// **************************************************

		$("div#grid").kendoGrid({

			// **************************************************
			sortable: {

				//mode: "single",
				mode: "multiple",
				allowUnsort: true,

			},

			pageable: {

				info: true,
				input: true,
				refresh: true,
				numeric: true,
				buttonCount: 5,
				previousNext: true,
				pageSizes: [5, 10, 25, 50, 100],
				messages: {

					morePages: "صفحات بيشتر",
					page: "شماره صفحه",

				}

			},

			groupable: false,
			filterable: false,
			scrollable: false,
			reorderable: true,

			columnMenu: {

				columns: true,
				sortable: true,
				filterable: false,
				messages: {

					lock: "قفل شده",
					unlock: "قفل نشده",

				}

			},

			navigatable: true,
			selectable: "multiple row",

			dataSource: varDataSource,

			dataBinding: function () {

				rowNumber =
					(this.dataSource.page() - 1) * this.dataSource.pageSize();

			},

			dataBound: function () {

				doSomeEffects();

			},
			// **************************************************

			columns:
			[
				{
					width: "40px",
					hidden: false,
					locked: false,
					lockable: false,
					sortable: false,
					title: "رديف",
					template: "#= ++rowNumber #",
				},

				{
					width: "40px",
					hidden: false,
					locked: false,
					lockable: false,
					sortable: false,
					title: "",
					template: function (dataItem) {

						var strTemplate = " ";

						strTemplate +=
							'<a data-toggle="tooltip" data-placement="top" title="@(Resources.Actions.Display)" href="/ECommerce/Transaction/Display/'
							+ dataItem.Id + '"><span class="glyphicon glyphicon-eye-open"></span></a>';

						return (strTemplate);
					},
				},

				{
					width: "80px",
					hidden: false,
					locked: false,
					lockable: false,
					sortable: true,
					title: "@(Resources.Models.ECommerce.Transaction.IsPaidOnline)",
					field: "@(Resources.Models.ECommerce.Strings.TransactionKeys.IsPaidOnline)",
					template: function (dataItem) {

						var strTemplate =
							'<span class="glyphicon glyphicon-unchecked"></span>';

						if (dataItem.@(Resources.Models.ECommerce.Strings.TransactionKeys.IsPaidOnline)) {

							strTemplate =
								'<span data-toggle="tooltip" data-placement="top" title="@(Resources.Models.ECommerce.Transaction.IsPaidOnline)" class="glyphicon glyphicon-check"></span>';

						}

						return (strTemplate);

					},
				},

				{
					width: "80px",
					hidden: false,
					locked: false,
					lockable: false,
					sortable: true,
					title: "@(Resources.Models.ECommerce.Transaction.IsPending)",
					field: "@(Resources.Models.ECommerce.Strings.TransactionKeys.IsPending)",
					template: function (dataItem) {

						var strTemplate =
							'<span class="glyphicon glyphicon-unchecked"></span>';

						if (dataItem.@(Resources.Models.ECommerce.Strings.TransactionKeys.IsPending)) {

							strTemplate =
								'<span data-toggle="tooltip" data-placement="top" title="@(Resources.Models.ECommerce.Transaction.IsPending)" class="glyphicon glyphicon-check"></span>';

						}

						return (strTemplate);
					},
				},
				{
					hidden: false,
					locked: false,
					lockable: false,
					sortable: false,
					title: "@(Resources.Models.ECommerce.Transaction.PlanId)" + " / " + "@(Resources.Models.General.Description)",
					template: function(dataItem) {

						var strResult = "";

						if(dataItem.PlanId != null) {

							strResult =
								"@(Resources.Models.ECommerce.Transaction.PlanId): ";

							strResult +=
								'<a href="/ECommerce/Plan/DisplayPlan/' + dataItem.PlanId + '">' + dataItem.PlanName + '</a>';

						}

						if(dataItem.Description != null) {

							if(strResult != "") {

								strResult += "<br />";

							}

							strResult += dataItem.Description;

						}

						return(strResult);

					},

				},

				{
					width: "80px",
					hidden: false,
					locked: false,
					lockable: false,
					sortable: false,
					title: "@(Resources.Models.ECommerce.Transaction.Credit)",
					template: function(dataItem) {

						var strResult =
							dataItem.DisplayCredit;

						return(strResult);

					},
				},

				{
					width: "80px",
					hidden: false,
					locked: false,
					lockable: false,
					sortable: false,
					title: "@(Resources.Models.ECommerce.Transaction.Debit)",
					template: function(dataItem) {

						var strResult =
							dataItem.DisplayDebit;

						return(strResult);
					},
				},

				{
					width: "80px",
					hidden: false,
					locked: false,
					lockable: false,
					sortable: false,
					title: "@(Resources.Models.ECommerce.Transaction.SiteCredit)",
					template: function(dataItem) {

						var strResult =
							dataItem.DisplaySiteCredit;

						return(strResult);

					},
				},

				{
					width: "80px",
					hidden: false,
					locked: false,
					lockable: false,
					sortable: false,
					title: "@(Resources.Models.ECommerce.Transaction.SiteDebit)",
					template: function(dataItem) {

						var strResult =
							dataItem.DisplaySiteDebit;

						return(strResult);

					},
				},

				{
					width: "120px",
					hidden: false,
					locked: false,
					lockable: false,
					sortable: false,
					title: "@Resources.Models.General.UpdateDateTime",
					template: function(dataItem) {

						var strResult =
							dataItem.UpdateDateTime.DisplayDateTime;

						return(strResult);

					},
				},
			]
		});

		$("button#btnSearch").click(function(){

			//var varData =
			//	$("form#frmData").serialize();

			var varData = {

				Description: function () {

					return ($("input#Description").val());

				},

			};

			varDataSourceSettings.transport.read.data = varData;

			varDataSource =
				new kendo.data.DataSource(varDataSourceSettings);

			var varGrid =
				$('div#grid').data("kendoGrid");

			varGrid.setDataSource(varDataSource);

		});

	});
</script>

@Html.DtxBeginPanel()

@Html.DtxBeginPanelHeading(id: "divSearch")
@Html.DtxPanelTitle(Resources.Actions.Search)
@Html.DtxEndPanelHeading()

@Html.DtxBeginPanelBody()
@Html.DtxBeginForm(id: "frmData")
@Html.DtxLabelTextBoxFor(model => model.Description)

@Html.DtxSimpleButton(id: "btnSearch",
	caption: Resources.Buttons.Search)
@Html.DtxSimpleReset()
@Html.DtxEndForm()
@Html.DtxEndPanelBody()

@Html.DtxBeginPanelFooter()
<ul>
	<li>
		تمام واحدهای پولی، به ريال می‌باشند.
	</li>
	<li>
		اعتبار شما
		@Html.Raw(MY_WEB_APPLICATION.Areas.ECommerce.BLL.User.GetUserCreditAndDebitSumery(Infrastructure.Sessions.AuthenticatedUser.Id).DisplayBalance)
		ريال می‌باشد.
		برای افزايش اعتبار، بر روی اين
		@Html.ActionLink("[" + "لينک" + "]", MVC.ECommerce.Transaction.IncreaseCreditByOnlinePayment())
		کليک نماييد.
	</li>
</ul>
@Html.DtxEndPanelFooter()

@Html.DtxEndPanel()



@Html.DtxBeginPanel()

@Html.DtxBeginPanelHeading()
@Html.DtxPanelTitle(strTitle)
@Html.DtxEndPanelHeading()

@Html.DtxBeginPanelBody()
@Html.DtxGrid(id: "grid")
@Html.DtxEndPanelBody()

@Html.DtxEndPanel()
