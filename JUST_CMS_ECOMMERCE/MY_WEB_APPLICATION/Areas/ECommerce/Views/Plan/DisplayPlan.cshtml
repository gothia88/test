@model Models.ECommerce.Plan

@{
	string strTitle =
		string.Format("{0} {1}",
		Resources.Actions.DetailsOf,
		Resources.Models.ECommerce.Plan.EntityName);

	ViewBag.Title = strTitle;
}

@Html.DtxBeginPanel()

@Html.DtxBeginPanelHeading()
@Html.DtxPanelTitle(strTitle)
@Html.DtxEndPanelHeading()

@Html.DtxBeginPanelBody()
@Html.DtxDisplayNameAndValueFor(model => model.Name,
	labelColumn: 5)

@Html.DtxDisplayNameAndValueFor(model => model.Price,
	Infrastructure.Enums.DisplayValueTypes.Currency,
	labelColumn: 5)

@Html.DtxDisplayNameAndValueFor(model => model.DurationInMonth,
	Infrastructure.Enums.DisplayValueTypes.Number,
	labelColumn: 5)

@Html.DtxDisplayNameAndValueFor(model => model.MaxDownloadSpeedInKB,
	Infrastructure.Enums.DisplayValueTypes.Number,
	labelColumn: 5)

@Html.DtxDisplayNameAndValueFor(model => model.MaxFileLengthForUploadingInMB,
	Infrastructure.Enums.DisplayValueTypes.Number,
	labelColumn: 5)

@Html.DtxDisplayNameAndValueFor(model => model.SiteCommissionRate,
	Infrastructure.Enums.DisplayValueTypes.Percent,
	labelColumn: 5)

@Html.DtxDisplayNameAndValueFor(model => model.ExtraSiteCommissionRateForIsFeaturedProducts,
	Infrastructure.Enums.DisplayValueTypes.Percent,
	labelColumn: 5)

@Html.DtxDisplayNameAndValueFor(model => model.MinCreditForPayment,
	Infrastructure.Enums.DisplayValueTypes.Currency,
	labelColumn: 5)

@Html.DtxDisplayNameAndValueFor(model => model.MaxTimeForPaymentInHour,
	Infrastructure.Enums.DisplayValueTypes.Number,
	labelColumn: 5)

@Html.DtxDisplayNameAndValueFor(model => model.SmsNotification,
	labelColumn: 5)

@if (string.IsNullOrWhiteSpace(Model.Description) == false)
{
	@Html.DtxDisplayNameAndValueFor(model => model.Description,
		Infrastructure.Enums.DisplayValueTypes.Raw,
		labelColumn: 5)
}

@if ((Model.IsActive) && (Model.IsDeleted == false))
{
	<br />

	if (Model.Price == 0)
	{
		<div class="row">
			<div class="col-sm-2">
				<a href="~/ECommerce/Plan/SelectFreePlan/@(Model.Id)">
					<img src="~/Content/Images/SelectFreePlan.png" alt="Select Free Plan" title="Select Free Plan" class="img-responsive img-rounded" />
				</a>
			</div>
		</div>
	}
	else
	{
		<div class="row">
			<div class="col-sm-2">
				<a href="~/ECommerce/Transaction/BuyPlanByCredit/@(Model.Id)">
					<img src="~/Content/Images/PayByCredit.png" alt="Pay By Credit" title="Pay By Credit" class="img-responsive img-rounded" />
				</a>
			</div>
		</div>
	}
}
@Html.DtxEndPanelBody()

@Html.DtxEndPanel()
