@model Models.ECommerce.Plan

@section headSection
{
	@Html.Partial(MVC.Shared.Views._Partial_TinyMce)
}

@{
	string strTitle =
		string.Format("{0} {1}",
		Resources.Actions.EditOf,
		Resources.Models.ECommerce.Plan.EntityName);

	ViewBag.Title = strTitle;
}

@using (Html.BeginForm())
{
	@Html.AntiForgeryToken()

	@Html.HiddenFor(model => model.Id)

	@Html.DtxBeginPanel()

	@Html.DtxBeginPanelHeading()
	@Html.DtxPanelTitle(strTitle)
	@Html.DtxEndPanelHeading()

	@Html.DtxBeginPanelBody()
	@Html.ValidationSummary(excludePropertyErrors: true)

	@Html.DtxCheckBoxFor(model => model.IsActive,
		labelColumn: 5)

	@*@Html.DtxCheckBoxFor(model => model.IsDeleted,
		labelColumn: 5)*@

	@Html.DtxCheckBoxFor(model => model.SmsNotification,
		labelColumn: 5)

	@Html.DtxLabelTextBoxFor(model => model.Ordering,
		leftToRight: true, labelColumn: 5)

	@Html.DtxLabelTextBoxFor(model => model.Name,
		labelColumn: 5)

	@Html.DtxLabelTextBoxFor(model => model.Price,
		leftToRight: true, labelColumn: 5)

	@Html.DtxLabelTextBoxFor(model => model.DurationInMonth,
		leftToRight: true, labelColumn: 5)

	@Html.DtxLabelTextBoxFor(model => model.MaxDownloadSpeedInKB,
		leftToRight: true, labelColumn: 5)

	@Html.DtxLabelTextBoxFor(model => model.MaxFileLengthForUploadingInMB,
		leftToRight: true, labelColumn: 5)

	@Html.DtxLabelTextBoxFor(model => model.MinCreditForPayment,
		leftToRight: true, labelColumn: 5)

	@Html.DtxLabelTextBoxFor(model => model.MaxTimeForPaymentInHour,
		leftToRight: true, labelColumn: 5)

	@Html.DtxLabelTextBoxFor(model => model.SiteCommissionRate,
		leftToRight: true, labelColumn: 5)

	@Html.DtxLabelTextBoxFor(model => model.ExtraSiteCommissionRateForIsFeaturedProducts,
		leftToRight: true, labelColumn: 5)

	@Html.DtxLabelTextAreaFor(model => model.Description,
		labelColumn: 5)

	@Html.DtxSubmit(Resources.Buttons.Save,
		columnOffset: 5)
	@Html.DtxEndPanelBody()

	@Html.DtxBeginPanelFooter()
	@Html.DtxActionLink(Resources.Actions.Details,
		MVC.ECommerce.Plan.Details(Model.Id))

	@Html.DtxActionLink(Resources.Actions.Delete,
		MVC.ECommerce.Plan.Delete(Model.Id))

	@Html.DtxActionLink(Resources.Actions.BackToList,
		MVC.ECommerce.Plan.Index())
	@Html.DtxEndPanelFooter()

	@Html.DtxEndPanel()
}
