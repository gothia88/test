@model IEnumerable<Models.Cms.Layout>

@{
	DAL.UnitOfWork oUnitOfWork = new DAL.UnitOfWork();

	string strTitle =
		string.Format("{0} {1}",
		Resources.Actions.ListOf,
		Resources.Models.Cms.Layout.EntitiesName);

	ViewBag.Title = strTitle;
}

@Html.DtxBeginPanel()

@Html.DtxBeginPanelHeading()
@Html.DtxPanelTitle(strTitle)
@Html.DtxEndPanelHeading()

@Html.DtxBeginPanelBody()
@{
	string strCreate =
		string.Format("{0} {1}",
		Resources.Actions.CreateOf,
		Resources.Models.Cms.Layout.EntityName);
}

@Html.DtxActionLink(strCreate,
	MVC.Cms.Layout.Create())

<br />
<br />

<div class="table-responsive">
	<table class="table table-striped table-bordered table-hover table-condensed">
		<tr>
			<th style="width: 175px;">
				&nbsp;
			</th>
			<th style="width: 75px;">
				@Html.DisplayNameFor(model => model.IsActive)
			</th>
			<th style="width: 100px;">
				@Html.DisplayNameFor(model => model.IsSystem)
			</th>
			<th style="width: 75px;">
				@Html.DisplayNameFor(model => model.Ordering)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Title)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Name)
			</th>
			<th style="width: 100px;">
				@Resources.Models.Cms.Layout.StaticPageCount
			</th>
			<th style="width: 100px;">
				@Resources.Models.Cms.Layout.DynamicPageCount
			</th>
			<th style="width: 160px;">
				@Resources.Models.General.InsertAndUpdateDateTime
			</th>
		</tr>

		@foreach (var item in Model)
		{
			string strRowStyle =
				Infrastructure.Utility.GetRowStyle(item);

			<tr class="@strRowStyle">
				<td>
					@Html.DtxActionLink(Resources.Actions.Details,
						MVC.Cms.Layout.Details(item.Id),
						Infrastructure.Enums.ActionLinksTypes.Details)

					@Html.DtxActionLink(Resources.Actions.Edit,
						MVC.Cms.Layout.Edit(item.Id),
						Infrastructure.Enums.ActionLinksTypes.Edit)

					@{
						int intDynamicPageCount =
							oUnitOfWork.CmsUnitOfWork.PageRepository
							.GetPageCountByLayoutId(item.Id);

						int intStaticPageCount =
							oUnitOfWork.ProjectActionRepository
							.GetProjectActionCountByLayoutId(item.Id);

						if ((item.IsSystem == false) &&
							(intStaticPageCount == 0) &&
							(intDynamicPageCount == 0))
						{
							@Html.DtxActionLink(Resources.Actions.Delete,
								MVC.Cms.Layout.Delete(item.Id),
								Infrastructure.Enums.ActionLinksTypes.Delete)
						}
					}

					<br />
					@Html.DtxActionLink(Resources.Actions.Copy,
						MVC.Cms.Layout.Copy(item.Id))
					<br />
					@Html.DtxActionLink(Resources.Actions.SelectPagesForLayout,
						MVC.Cms.Layout.SelectPages(item.Id))
					<br />
					@Html.DtxActionLink(Resources.Actions.SelectProjectActionsForLayout,
						MVC.Cms.Layout.SelectProjectActions(item.Id))
					<br />
					@Html.DtxActionLink(Resources.Actions.ManageFoldersAndFiles,
						MVC.Cms.Layout.ManageFoldersAndFiles(item.Id))
					<br />
					@Html.DtxActionLink(Resources.Actions.EditLayoutContent,
						MVC.Cms.Layout.EditLayoutContent(item.Id))
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.IsActive)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.IsSystem)
				</td>
				<td>
					@Dtx.Text.Convert.DisplayFormattedNumber(item.Ordering)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Title)
				</td>
				<td style="direction: ltr">
					@Html.DisplayFor(modelItem => item.Name)
				</td>
				<td>
					@Dtx.Text.Convert.DisplayFormattedNumber(intStaticPageCount)
				</td>
				<td>
					@Dtx.Text.Convert.DisplayFormattedNumber(intDynamicPageCount)
				</td>
				<td>
					@Html.DisplayDateTime(item.InsertDateTime, displayTime: true)
					<br />
					@Html.DisplayDateTime(item.UpdateDateTime, displayTime: true)
				</td>
			</tr>
		}
	</table>
</div>
@Html.DtxEndPanelBody()

@Html.DtxBeginPanelFooter()
@Html.DtxEndPanelFooter()

@Html.DtxEndPanel()
