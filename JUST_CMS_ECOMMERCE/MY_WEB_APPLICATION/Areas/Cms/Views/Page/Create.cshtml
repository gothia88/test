@model Models.Cms.Page

@section headSection
{
	@Html.Partial(MVC.Shared.Views._Partial_TinyMce)
}

@{
	string strTitle =
		string.Format("{0} {1}",
		Resources.Actions.CreateOf,
		Resources.Models.Cms.Page.EntityName);

	ViewBag.Title = strTitle;
}

@using (Html.BeginForm())
{
	@Html.AntiForgeryToken()

	@Html.DtxBeginPanel()

	@Html.DtxBeginPanelHeading()
	@Html.DtxPanelTitle(strTitle)
	@Html.DtxEndPanelHeading()

	@Html.DtxBeginPanelBody()
	@Html.ValidationSummary(excludePropertyErrors: true)

	@Html.DtxCheckBoxFor(model => model.IsDraft)

	@Html.DtxLabelTextBoxFor(model => model.Name, leftToRight: true)

	@Html.DtxLabelTextBoxFor(model => model.Title)

	@Html.DtxLabelDropDownListFor(model => model.LayoutId)

	@Html.DtxLabelTextAreaFor(model => model.PageContent.Content)

	@Html.DtxLabelTextBoxFor(model => model.Ordering, leftToRight: true)

	@Html.DtxCheckBoxFor(model => model.IsActive)

	if (Infrastructure.Sessions.AuthenticatedUser.Role == Models.Enums.Roles.Programmer)
	{
		@Html.DtxCheckBoxFor(model => model.IsSystem)
	}

	@Html.DtxCheckBoxFor(model => model.IsVerified)

	@Html.DtxCheckBoxFor(model => model.IsDeleted)

	@Html.DtxLabelDropDownListFor(model => model.AccessTypeId)

	@Html.DtxLabelDateFor(model => model.StartPublishingDateTime)

	@Html.DtxLabelDateFor(model => model.FinishPublishingDateTime)

	@Html.DtxLabelTextBoxFor(model => model.Description)

	@Html.DtxLabelTextBoxFor(model => model.Tags)

	@Html.DtxLabelTextBoxFor(model => model.Keywords)

	@Html.DtxCheckBoxFor(model => model.DoesSearchEnginesIndexIt)

	@Html.DtxCheckBoxFor(model => model.DoesSearchEnginesFollowIt)

	@Html.DtxLabelTextBoxFor(model => model.Author)

	@Html.DtxLabelTextBoxFor(model => model.Classification)

	@Html.DtxLabelTextBoxFor(model => model.Copyright)

	@Html.DtxLabelTextBoxFor(model => model.Hits, leftToRight: true)

	@Html.DtxSubmit(Resources.Buttons.Create)
	@Html.DtxEndPanelBody()

	@Html.DtxBeginPanelFooter()
	@Html.DtxActionLink(Resources.Actions.BackToList,
		MVC.Cms.Page.Index())
	@Html.DtxEndPanelFooter()

	@Html.DtxEndPanel()
}
