<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Dtx</RootNamespace>
    <AssemblyName>Dtx</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Description>Modern .NET 10 port of the legacy Dtx utility library (Persian calendar, text conversion, hashing, RSS, SMTP mail, IO helpers).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Modern replacement for the legacy System.Linq.Dynamic (used by Dtx.Kendo grid sorting). -->
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.4" />
  </ItemGroup>

</Project>
