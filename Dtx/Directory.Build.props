<Project>
  <!-- Shields the Dtx port from the parent Clean Architecture template's
       Directory.Build.props (which forces net10.0 + warnings-as-errors). -->
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
